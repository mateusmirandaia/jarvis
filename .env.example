# =====================================================================
# Configuracao do Jarvis
# 1) Copie este arquivo para ".env"   (no PowerShell: copy .env.example .env)
# 2) Cole a sua chave em GEMINI_API_KEY
# O arquivo .env NUNCA vai para o GitHub (ele esta no .gitignore).
# Nunca mostre o .env na tela de uma gravacao ou live.
# =====================================================================

# Chave gratis do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo do modo texto (jarvis --modo texto)
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelo reserva: usado automaticamente se o principal estiver sobrecarregado (erro 5xx)
GEMINI_MODEL_RESERVA=gemini-flash-lite-latest

# Modelo de voz em tempo real (Gemini Live) usado pelo modo voz (jarvis)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Voz pronta do Google para o modo voz. Exemplos: Charon, Puck, Kore, Fenrir, Aoede, Orus
JARVIS_VOZ=Charon

# (Opcional) Seu nome. Com ele, o Jarvis se apresenta como "assistente pessoal do <nome>".
# Vazio = "seu assistente pessoal". Em qualquer caso ele chama voce de "senhor".
JARVIS_NOME_USUARIO=

# (Opcional e PAGO) Voz do ElevenLabs. Com as duas linhas preenchidas, o Jarvis fala com
# essa voz; o Gemini continua sendo o ouvido e o cerebro. Vazio = voz do Google (gratis).
# Chave: https://elevenlabs.io/app/settings/api-keys  |  ID da voz: aba "Voices" > "ID".
# Se o ElevenLabs falhar (sem creditos, chave errada), ele avisa e volta para a voz do Google.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Modelo de voz: eleven_flash_v2_5 e o mais rapido (recomendado para conversa).
ELEVENLABS_MODEL=eleven_flash_v2_5

# Silencio (em milissegundos) que encerra a sua fala. Menor = ele responde mais rapido,
# mas pode cortar voce numa pausa. Entre 200 e 2000. Padrao: 500.
JARVIS_SILENCIO_MS=500

# Usa fone de ouvido? Com "sim", o microfone fica aberto enquanto ele fala e voce pode
# interromper. Sem fone deixe "nao" (senao ele escuta a propria voz).
JARVIS_FONE=nao
